# Copia este archivo como .env (queda git-ignored) y completa los valores.
# run.ps1 lo carga solo antes de cada corrida.

# API key de Gemini (visión). La secundaria es opcional (rotación por cuota).
GEMINI_API_KEY=
GEMINI_API_KEY_SECONDARY=

# Supabase del proyecto (empresa). La KEY va la SECRET (sb_secret_..., ex
# service_role): Project Settings -> API Keys -> Secret keys. La publishable NO
# sirve para escribir el snapshot.
SUPABASE_URL=https://vvixdytgvmssvetxyboz.supabase.co
SUPABASE_KEY=

# Paceo entre llamadas a Gemini en segundos (free-tier; 0 = sin espera).
VISION_MIN_INTERVAL=10
